{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"],
      "@saymyname/contracts": ["../../packages/contracts/src/index.ts"],
      "@saymyname/contracts/*": ["../../packages/contracts/src/*"],
      "@saymyname/validation": ["../../packages/validation/src/index.ts"],
      "@saymyname/validation/*": ["../../packages/validation/src/*"],
      "@saymyname/design-tokens": ["../../packages/design-tokens/src/index.ts"],
      "@saymyname/design-tokens/*": ["../../packages/design-tokens/src/*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
