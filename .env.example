# Environment Configuration (Synthetic Development Defaults)
NODE_ENV=development
PORT=4000

# Database (PostgreSQL)
DATABASE_URL="postgresql://saymyname_user:saymyname_password@localhost:5432/saymyname_dev?schema=public"

# Redis
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=""

# JWT Secrets (Synthetic Dev Keys - Never use in production)
JWT_ACCESS_SECRET="dev-synthetic-access-secret-do-not-use-in-prod"
JWT_REFRESH_SECRET="dev-synthetic-refresh-secret-do-not-use-in-prod"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"

# Web & API URLs
API_BASE_URL="http://localhost:4000"
WEB_APP_URL="http://localhost:3000"
